    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "0.28.2",
    "puppeteer": "25.16.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
