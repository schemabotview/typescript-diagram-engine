{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "try.ts"
  ]
}
